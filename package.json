{
  "name": "shv-meteo-web",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Swiss Free Flight Web Application - Soaring Weather, Flying Sites & Airspaces (Data Source: SHV FSVL)",
  "scripts": {
    "dev": "node --experimental-strip-types scripts/dev.ts",
    "build": "astro build",
    "preview": "wrangler pages dev dist",
    "typecheck": "astro check",
    "test": "node --experimental-strip-types --test 'src/scripts/**/*.test.ts'",
    "e2e": "playwright test",
    "lint": "oxlint --deny-warnings . && prettier --check .",
    "format": "prettier --write .",
    "shot": "node --experimental-strip-types scripts/shot.ts",
    "prepare": "lefthook install || true",
    "gis": "node --experimental-strip-types scripts/gis.ts",
    "grid": "node --experimental-strip-types scripts/previtemps-grid.ts",
    "obstacles": "node --experimental-strip-types --max-old-space-size=4096 scripts/obstacles.ts"
  },
  "dependencies": {
    "astro": "^7.4.13",
    "chart.js": "^4.4.7",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.65.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "lefthook": "^2.2.2",
    "linkedom": "^0.18.15",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "rumdl": "^0.3.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.166.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "lefthook@2.2.2": true,
    "workerd@1.20261119.1": true
  }
}
