---
// The page frame every tab shares: the head from the former index.html and
// the four mount points the legacy views render into (src/main.js). The
// page's script loads main.js, which mounts the view <body data-view> names.
import "leaflet/dist/leaflet.css";
// main.css cut at its section banners, in its order, so every rule keeps
// its place in the cascade
import "../styles/tokens.css";
import "../styles/chrome.css";
import "../styles/map-controls.css";
import "../styles/map-layers.css";
import "../styles/map-markers.css";
import "../styles/sheet.css";
import "../styles/weather.css";
import "../styles/forecast.css";
import "../styles/safety.css";
import "../styles/forms.css";
import "../styles/responsive.css";
import "../styles/meteo-extras.css";
import "../styles/forecast-text.css";
import "../styles/forecast-outlooks.css";
import "../styles/forecast-emagram.css";

interface Props {
  /** The tab this page shows: map, weather, forecast or safety. */
  view: string;
}
const { view } = Astro.props;
---

<!doctype html>
<html lang="de" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover"
    />
    <title>Swiss Free Flight - Soaring Weather & Flying Sites</title>
    <link rel="icon" type="image/svg+xml" href="/assets/logo.svg" />
    <link rel="apple-touch-icon" href="/assets/logo.svg" />
    <meta name="theme-color" content="#0F172A" />
    <meta
      name="description"
      content="Swiss Free Flight - Live flying areas, airspaces, weather, Föhn, soundings and webcams for paragliding and hang gliding in Switzerland. Data sources: SHV FSVL, MeteoSwiss, Swisstopo, BAZL."
    />
    {/* The saved theme before the first paint, so a light theme doesn't
       flash dark on every page load (src/scripts/settings.ts). */}
    <script is:inline>
      try {
        if (localStorage.getItem("shv_theme") === "light")
          document.documentElement.setAttribute("data-theme", "light");
      } catch (err) {
        console.error("[Base] Cannot read the saved theme:", err);
      }
    </script>
  </head>
  <body data-view={view}>
    <div id="app">
      <div id="header-container"></div>
      <main id="view-container"></main>
      <div id="bottom-sheet-container" class="hidden"></div>
      <div id="bottom-nav-container"></div>
    </div>
    <slot />
  </body>
</html>
