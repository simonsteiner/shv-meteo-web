---
// The safety page: pre-flight check, emergency contacts and DABS. Static
// markup; src/scripts/safety/page.ts fills and drives it.
import Base from "../../layouts/Base.astro";
import Checklist from "../../components/safety/Checklist.astro";
import Emergency from "../../components/safety/Emergency.astro";
import Dabs from "../../components/safety/Dabs.astro";
---

<Base view="safety">
  <div slot="view" class="safety-view-wrapper" data-safety>
    <Checklist />
    <Emergency />
    <Dabs />
  </div>
  <script>
    import "../../scripts/safety/page.ts";
  </script>
</Base>
