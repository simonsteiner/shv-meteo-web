---
// The map page: flying sites, airspace, obstacles and live weather on a
// Leaflet map, with the layers drawer, search and filters. Static markup;
// src/scripts/maps/page.ts fills and drives it, and renders the bottom
// sheet. Deep links
// (src/scripts/handoff.ts): /map/?site=<siteId>, ?station=<id>,
// ?webcam=<id>, ?locate, each with an optional &z=<zoom>.
import Base from "../../layouts/Base.astro";
import BottomStack from "../../components/map/BottomStack.astro";
import Fabs from "../../components/map/Fabs.astro";
import LayersDrawer from "../../components/map/LayersDrawer.astro";
import SearchBar from "../../components/map/SearchBar.astro";
---

<Base view="map">
  <div slot="view" class="map-view-wrapper" data-map-page>
    <SearchBar />
    <Fabs />
    <LayersDrawer />
    <BottomStack />
    <div class="leaflet-map-element" data-leaflet-map></div>
  </div>
  <script>
    import "../../scripts/maps/page.ts";
  </script>
</Base>
