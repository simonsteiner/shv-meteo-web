---
// The four forecast sections as links: each is its own page
// (/forecast/ for the text, /forecast/<section>/ for the others), so a
// section can be linked and loads only its own data.
interface Props {
  active: "text" | "outlooks" | "emagram" | "isobaren";
}
const { active } = Astro.props;
const SECTIONS = [
  { id: "text", href: "/forecast/", key: "forecast.navText" },
  { id: "outlooks", href: "/forecast/outlooks/", key: "forecast.navOutlooks" },
  { id: "emagram", href: "/forecast/emagram/", key: "forecast.navEmagram" },
  { id: "isobaren", href: "/forecast/isobaren/", key: "forecast.navIsobaren" },
] as const;
---

<nav class="forecast-top-bar">
  <div class="forecast-section-switcher">
    {SECTIONS.map((s) => (
      <a
        href={s.href}
        class:list={["forecast-tab-btn", { active: s.id === active }]}
        aria-current={s.id === active ? "page" : undefined}
      >
        {s.id === "text" && (
          <svg
            width="17"
            height="17"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <polyline points="14 2 14 8 20 8" />
            <line x1="16" y1="13" x2="8" y2="13" />
            <line x1="16" y1="17" x2="8" y2="17" />
          </svg>
        )}
        {s.id === "outlooks" && (
          <svg
            width="17"
            height="17"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="5" />
            <line x1="12" y1="1" x2="12" y2="3" />
            <line x1="12" y1="21" x2="12" y2="23" />
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
            <line x1="1" y1="12" x2="3" y2="12" />
            <line x1="21" y1="12" x2="23" y2="12" />
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
          </svg>
        )}
        {s.id === "emagram" && (
          <svg
            width="17"
            height="17"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M3 3v18h18" />
            <path d="m19 9-5 5-4-4-3 3" />
          </svg>
        )}
        {s.id === "isobaren" && (
          <svg
            width="17"
            height="17"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10" />
            <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
          </svg>
        )}
        <span data-t={s.key} />
      </a>
    ))}
  </div>
</nav>
