---
// The isobar chart, an SVG upstream draws per language (German for
// English); src/scripts/forecast/isobaren-page.ts sets its source and
// zooms it on a tap.
---

<div class="forecast-content-card" data-forecast-isobaren>
  <div class="section-header-row">
    <div>
      <span class="badge-tag">MeteoSchweiz / DWD</span>
      <h2 class="section-heading" data-t="forecast.isobarenTitle"></h2>
      <p class="section-sub" data-t="forecast.isobarenSub"></p>
    </div>
  </div>

  <div class="isobaren-map-container" data-isobaren-box>
    <button
      type="button"
      class="isobaren-zoom"
      aria-pressed="false"
      aria-describedby="isobaren-hint"
      data-isobaren-zoom
    >
      <img
        class="isobaren-img"
        data-isobaren-img
        data-t-alt="forecast.isobarenAlt"
        loading="eager"
        alt=""
      />
    </button>
  </div>
  <p class="isobaren-hint" id="isobaren-hint" data-isobaren-hint hidden></p>
</div>

<script>
  import "../../scripts/forecast/isobaren-page.ts";
</script>
