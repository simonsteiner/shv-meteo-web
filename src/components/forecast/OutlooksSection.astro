---
// The outlook animation: sunshine or precipitation over Switzerland in
// 6-hour frames on a Swisstopo map, with a player. src/scripts/forecast/
// outlooks-page.ts loads the frames and colours them.
import { OUTLOOK_TYPES } from "../../scripts/forecast/outlooks.ts";
const TYPES = [
  { icon: "☀️", key: "forecast.typeSunshine" },
  { icon: "🌧️", key: "forecast.typePrecipWeak" },
  { icon: "⛈️", key: "forecast.typePrecipStrong" },
];
const TICKS = ["0%", "20%", "40%", "60%", "80%", "100%"];
---

<div class="forecast-content-card" data-forecast-outlooks>
  <div class="section-header-row">
    <div>
      <span class="badge-tag">MeteoSchweiz & Ubique ICON-CH2</span>
      <h2 class="section-heading" data-t="forecast.outlooksTitle"></h2>
      <p class="section-sub" data-t="forecast.outlooksSub"></p>
    </div>
  </div>

  <div class="text-category-switcher-row outlook-types">
    {OUTLOOK_TYPES.map((type, i) => (
      <button type="button" class="category-pill" data-type={type}>
        {TYPES[i].icon} <span data-t={TYPES[i].key} />
      </button>
    ))}
  </div>

  <p class="text-muted" data-outlook-status data-t="forecast.loading"></p>

  <div class="outlook-player-container" data-outlook-player hidden>
    <div class="outlook-time-banner">
      <div class="outlook-time-title">
        <span class="calendar-icon">📅</span>
        <strong class="outlook-time-text" data-outlook-time></strong>
      </div>
      <div class="outlook-step-indicator" data-outlook-step></div>
    </div>

    <div class="outlook-map-wrapper">
      <div class="outlook-map-container" data-outlook-map></div>
      <button
        type="button"
        class="outlook-center-btn"
        data-outlook-center
        data-t-title="forecast.centerTitle"
      >
        🇨🇭 <span data-t="forecast.center"></span>
      </button>
    </div>

    <div class="outlook-controls-bar">
      <button
        type="button"
        class="player-btn"
        data-outlook-step-by="-1"
        data-t-title="forecast.prevInterval"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <polygon points="19 20 9 12 19 4 19 20"></polygon>
          <line x1="5" y1="19" x2="5" y2="5"></line>
        </svg>
      </button>
      <button
        type="button"
        class="player-btn primary"
        data-outlook-play
        data-t-title="forecast.playPause"
      >
        <svg
          class="icon-play"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <polygon points="5 3 19 12 5 21 5 3"></polygon>
        </svg>
        <svg
          class="icon-pause"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <rect x="6" y="4" width="4" height="16"></rect>
          <rect x="14" y="4" width="4" height="16"></rect>
        </svg>
      </button>
      <button
        type="button"
        class="player-btn"
        data-outlook-step-by="1"
        data-t-title="forecast.nextInterval"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <polygon points="5 4 15 12 5 20 5 4"></polygon>
          <line x1="19" y1="5" x2="19" y2="19"></line>
        </svg>
      </button>
      <input
        type="range"
        class="outlook-timeline-slider"
        data-outlook-slider
        min="0"
        max="0"
        value="0"
        step="1"
        data-t-aria-label="forecast.timeline"
      />
    </div>

    <div class="outlook-legend-container">
      <span class="legend-title" data-outlook-legend-title></span>
      <div class="legend-color-bar" data-outlook-legend-bar></div>
      <div class="legend-ticks">
        {TICKS.map((t) => (
          <span>{t}</span>
        ))}
      </div>
    </div>
  </div>
</div>

<script>
  import "../../scripts/forecast/outlooks-page.ts";
</script>
