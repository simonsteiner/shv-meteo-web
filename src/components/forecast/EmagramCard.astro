---
// The emagram card: the placeholder before a station is chosen, the
// loading and empty states, and the chart with its time slider. The grid
// is drawn here at build time (src/scripts/forecast/emagram.ts); the
// curves, the altitude lines and the ruler are filled in the browser.
import {
  gridSvg,
  PAD_L,
  PAD_T,
  PLOT_H,
  PLOT_W,
  SVG_H,
  SVG_W,
} from "../../scripts/forecast/emagram.ts";
const base = PAD_T + PLOT_H;
---

<div class="emagram-placeholder-prompt" data-emagram-state="pick">
  <div class="emagram-placeholder-icon">📈</div>
  <div class="emagram-placeholder-content">
    <h4 data-t="forecast.pickTitle"></h4>
    <p data-t="forecast.pickText"></p>
  </div>
</div>

<div class="emagram-backdrop" data-emagram-backdrop hidden></div>
<div class="emagram-android-frame" data-emagram-frame hidden>
  <div class="emagram-top-nav">
    <button type="button" class="emagram-nav-btn" data-emagram-back>
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        aria-hidden="true"
      >
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
    </button>
    <div class="emagram-title-center">
      <h3 data-emagram-station></h3>
      <span>
        <span data-t="forecast.emagramForecast"></span>
        <span
          data-emagram-fullscreen-label
          hidden
          data-t="forecast.fullscreenSuffix"
        ></span>
      </span>
    </div>
    <button
      type="button"
      class="emagram-nav-btn"
      data-emagram-info-open
      data-t-title="forecast.info"
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="16" x2="12" y2="12"></line>
        <line x1="12" y1="8" x2="12.01" y2="8"></line>
      </svg>
    </button>
  </div>

  <div class="emagram-header-meta">
    <div>
      <div class="emagram-timestamp-badge" data-emagram-time></div>
      <div class="emagram-model-badge">ICON-CH1 · MeteoSchweiz</div>
    </div>
    <button type="button" class="emagram-expand-btn" data-emagram-expand>
      <svg
        class="icon-expand"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        aria-hidden="true"
      >
        <polyline points="15 3 21 3 21 9"></polyline>
        <polyline points="9 21 3 21 3 15"></polyline>
        <line x1="21" y1="3" x2="14" y2="10"></line>
        <line x1="3" y1="21" x2="10" y2="14"></line>
      </svg>
      <svg
        class="icon-shrink"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        aria-hidden="true"
      >
        <polyline points="4 14 10 14 10 20"></polyline>
        <polyline points="20 10 14 10 14 4"></polyline>
        <line x1="14" y1="10" x2="21" y2="3"></line>
        <line x1="3" y1="21" x2="10" y2="14"></line>
      </svg>
    </button>
  </div>

  <div class="emagram-empty-state" data-emagram-state="status" hidden>
    <p class="emagram-empty-title" data-emagram-status></p>
    <p class="emagram-empty-hint" data-emagram-status-hint></p>
  </div>

  <div data-emagram-state="chart" hidden>
    <div class="emagram-chart-container">
      <svg viewBox={`0 0 ${SVG_W} ${SVG_H}`} class="emagram-svg">
        <g class="grid-layer">
          <g set:html={gridSvg()} />
          <g data-emagram-altitudes></g>
        </g>
        <line
          x1={PAD_L + PLOT_W}
          y1={PAD_T}
          x2={PAD_L + PLOT_W}
          y2={base}
          stroke="var(--border-color, #CBD5E1)"
          stroke-width="1.5"
        ></line>
        <polyline
          data-emagram-dew
          points=""
          fill="none"
          stroke="#0284C7"
          stroke-width="2.2"
          stroke-dasharray="4,4"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></polyline>
        <g data-emagram-temp class="temp-curve-layer"></g>
        <polyline
          data-emagram-wind
          points=""
          fill="none"
          stroke="#0284C7"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></polyline>
        <g data-emagram-barbs class="wind-barbs-layer"></g>
        <text
          x={PAD_L - 10}
          y={base + 20}
          fill="#64748B"
          font-size="12"
          font-weight="700"
        >
          hPa
        </text>
        <rect
          x={PAD_L + 70}
          y={base + 8}
          width="140"
          height="22"
          rx="11"
          fill="var(--bg-secondary, #F1F5F9)"
        ></rect>
        <text
          x={PAD_L + 140}
          y={base + 23}
          fill="#64748B"
          font-size="11"
          font-weight="700"
          text-anchor="middle"
          data-t="forecast.tempAxis"
        ></text>
        <rect
          x={PAD_L + PLOT_W + 10}
          y={base + 8}
          width="105"
          height="22"
          rx="11"
          fill="var(--bg-secondary, #F1F5F9)"
        ></rect>
        <text
          x={PAD_L + PLOT_W + 62}
          y={base + 23}
          fill="#64748B"
          font-size="11"
          font-weight="700"
          text-anchor="middle"
          data-t="forecast.windAxis"
        ></text>
        <text
          x={PAD_L + PLOT_W + 35}
          y={base + 42}
          fill="#94A3B8"
          font-size="10"
          font-weight="600"
          text-anchor="middle"
        >
          15
        </text>
        <text
          x={PAD_L + PLOT_W + 62}
          y={base + 42}
          fill="#94A3B8"
          font-size="10"
          font-weight="600"
          text-anchor="middle"
        >
          30
        </text>
        <text
          x={PAD_L + PLOT_W + 90}
          y={base + 42}
          fill="#94A3B8"
          font-size="10"
          font-weight="600"
          text-anchor="middle"
        >
          45
        </text>
      </svg>
    </div>

    <div class="emagram-lapse-legend">
      <div class="emagram-lapse-bar"></div>
      <div class="emagram-lapse-ticks">
        <span>-1.0</span>
        <span>-0.8</span>
        <span>-0.6</span>
        <span>-0.3</span>
        <span>0.0</span>
      </div>
      <div class="emagram-lapse-unit">°C / 100 m</div>
    </div>

    <div class="emagram-timeline-panel">
      <div class="emagram-timeline-track">
        <div class="emagram-slider-inner-container">
          <svg
            class="emagram-ruler-svg"
            viewBox="0 0 1000 48"
            preserveAspectRatio="none"
            data-emagram-ruler
          ></svg>
          <div class="emagram-cursor-indicator" data-emagram-cursor>
            <div class="emagram-cursor-line"></div>
            <div class="emagram-cursor-dot"></div>
          </div>
          <input
            type="range"
            class="emagram-time-slider"
            data-emagram-slider
            min="0"
            max="0"
            value="0"
            step="0.02"
            data-t-aria-label="forecast.timeline"
          />
        </div>
      </div>
      <div class="emagram-timeline-bottom-row">
        <button
          type="button"
          class="emagram-stepper-btn"
          data-emagram-step-by="-1"
          data-t-title="forecast.prevHour"
        >
          &lt;&lt;
        </button>
        <div class="emagram-date-and-step">
          <span class="emagram-date-label" data-emagram-date></span>
          <span class="emagram-step-label" data-emagram-step></span>
        </div>
        <button
          type="button"
          class="player-btn primary emagram-play-btn"
          data-emagram-play
          data-t-title="forecast.play"
        >
          <svg
            class="icon-play"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
          <svg
            class="icon-pause"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <rect x="6" y="4" width="4" height="16"></rect>
            <rect x="14" y="4" width="4" height="16"></rect>
          </svg>
        </button>
        <button
          type="button"
          class="emagram-stepper-btn"
          data-emagram-step-by="1"
          data-t-title="forecast.nextHour"
        >
          &gt;&gt;
        </button>
      </div>
    </div>
  </div>
</div>
