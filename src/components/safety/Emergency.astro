---
// Emergency numbers, the rescue radio channel and the tree landing steps:
// fixed content, worded from src/i18n through data-t.
const TREE_STEPS = [1, 2, 3, 4];
---

<section id="sos" class="safety-section sos-card">
  <div class="section-header-row">
    <div>
      <span class="badge-tag tag-sos" data-t="safety.sosBadge"></span>
      <h2 class="section-heading" data-t="safety.sosTitle"></h2>
      <p class="section-sub" data-t="safety.sosSub"></p>
    </div>
  </div>

  <div class="sos-buttons-grid">
    <a href="tel:1414" class="sos-btn btn-rega">
      <span class="sos-name" data-t="safety.regaName"></span>
      <span class="sos-phone">REGA 1414</span>
      <span class="sos-sub" data-t="safety.regaSub"></span>
    </a>
    <a href="tel:112" class="sos-btn btn-euro">
      <span class="sos-name" data-t="safety.euroName"></span>
      <span class="sos-phone">112</span>
      <span class="sos-sub" data-t="safety.euroSub"></span>
    </a>
  </div>

  <div class="radio-box">
    <div class="radio-icon">
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path d="M4.9 19.1C1 15.2 1 8.8 4.9 4.9"></path>
        <path d="M7.8 16.2c-2.3-2.3-2.3-6.1 0-8.5"></path>
        <circle cx="12" cy="12" r="2"></circle>
        <path d="M16.2 7.8c2.3 2.3 2.3 6.1 0 8.5"></path>
        <path d="M19.1 4.9C23 8.8 23 15.1 19.1 19"></path>
      </svg>
    </div>
    <div class="radio-info">
      <h4 class="radio-title" data-t="safety.kRadio"></h4>
      <p class="radio-sub" data-t="safety.kRadioSub"></p>
    </div>
  </div>

  <div class="tree-rescue-box">
    <h4 class="tree-heading">
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <polygon points="12 2 2 22 22 22"></polygon>
      </svg>
      <span data-t="safety.treeRescueTitle"></span>
    </h4>
    <ul class="tree-steps">
      {TREE_STEPS.map((n) => (
        <li data-t={`safety.treeRescue${n}`} />
      ))}
    </ul>
  </div>
</section>
