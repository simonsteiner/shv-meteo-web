---
// The Daily Airspace Bulletin card: a reminder with skybriefing's links.
// Nothing is fetched, so it claims no status and no validity. Today's and
// tomorrow's PDF are skybriefing's own links (/o/dabs?today, ?tomorrow,
// checked 2026-11-25); the page is the one the official app links.
const BULLETIN_URL = "https://www.skybriefing.com/de/dabs";
const PDF_TODAY_URL = "https://www.skybriefing.com/o/dabs?today";
const PDF_TOMORROW_URL = "https://www.skybriefing.com/o/dabs?tomorrow";
---

<section id="dabs" class="safety-section">
  <div class="section-header-row">
    <div>
      <span class="badge-tag" data-t="safety.dabsBadge"></span>
      <h2 class="section-heading" data-t="safety.dabsTitle"></h2>
      <p class="section-sub" data-t="safety.dabsSub"></p>
    </div>
  </div>

  <div class="dabs-card-box">
    <p class="dabs-notes" data-t="safety.dabsNotes"></p>
    <div class="dabs-links">
      <a href={BULLETIN_URL} target="_blank" rel="noopener" class="btn-primary">
        <span data-t="safety.dabsLink"></span> ↗
      </a>
      <a
        href={PDF_TODAY_URL}
        target="_blank"
        rel="noopener"
        class="btn-secondary"
      >
        <span data-t="safety.dabsPdfToday"></span> ↗
      </a>
      <a
        href={PDF_TOMORROW_URL}
        target="_blank"
        rel="noopener"
        class="btn-secondary"
      >
        <span data-t="safety.dabsPdfTomorrow"></span> ↗
      </a>
    </div>
  </div>
</section>
