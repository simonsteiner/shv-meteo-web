---
// The acoustic vario simulator: a slider for the climb rate and a sound
// toggle. page.ts drives the gauge and src/scripts/safety/audio.ts the
// sound.
import { VARIO_RANGE } from "../../scripts/settings.ts";
import { formatRate } from "../../scripts/safety/vario.ts";
const [min, max] = VARIO_RANGE;
---

<section id="vario" class="safety-section vario-card">
  <div class="section-header-row">
    <div>
      <span class="badge-tag">Web Audio API</span>
      <h2 class="section-heading" data-t="safety.varioTitle"></h2>
      <p class="section-sub" data-t="safety.varioSub"></p>
    </div>
    <button type="button" data-action="toggle-vario" class="btn-vario-audio">
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
        <g data-vario-icon="on">
          <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
        </g>
        <g data-vario-icon="off">
          <line x1="23" y1="9" x2="17" y2="15"></line>
          <line x1="17" y1="9" x2="23" y2="15"></line>
        </g>
      </svg>
      <span data-vario-label></span>
    </button>
  </div>

  <div class="vario-display-box">
    <div class="vario-gauge" data-vario-gauge>
      <span class="vario-digital" data-vario-rate></span>
      <span class="vario-unit">m/s</span>
    </div>
    <div class="vario-slider-wrapper">
      <input
        type="range"
        data-vario-slider
        min={min}
        max={max}
        step="0.1"
        data-t-aria-label="safety.varioClimb"
      />
      <div class="vario-scale-ticks">
        <span>
          {formatRate(min)} (<span data-t="safety.varioSinkLabel"></span>)
        </span>
        <span>{formatRate(0)}</span>
        <span>
          {formatRate(max)} (<span data-t="safety.varioLiftLabel"></span>)
        </span>
      </div>
    </div>
  </div>
</section>
